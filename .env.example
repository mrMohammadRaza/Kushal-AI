# ==============================================================================
# KAUSHAL AI — ROOT ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env before starting the platform services.
# NEVER commit real credentials, passwords, or private keys to source control.

# --- Backend Application Server ---
NODE_ENV=development
PORT=5000

# Mandatory: 64-character cryptographic secret for JWT authentication tokens
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_min_32_characters_here

# AI Microservice Endpoint
AI_SERVICE_URL=http://127.0.0.1:8000

# Mandatory: Explicit CORS Origin allowlist (comma-separated origins)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# --- AI & Vision Services ---
# Gemini Flash API Key for Multi-modal Vision, Audio & Viva Evaluation
# Obtain from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# --- Optional Cloud Persistence (Supabase PostgreSQL / Storage) ---
# If omitted, platform runs in resilient standalone SQLite mode
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_PROJECT_REF=your_supabase_project_ref

# --- DigiLocker National Gateway Integration (Pilot Sandbox) ---
# DigiLocker Issuer HMAC Key for NeGD XML Payload Signing
DIGILOCKER_API_KEY=your_digilocker_hmac_signing_key_here
